[general]
; true = overlay is visible in screenshots/OBS captures
; false = hide overlay from supported capture methods
Capture=true

; true = show per-lane Fast (Blue Up Arrow) / Slow (Red Down Arrow) fadeout indicators
; false = hide Fast/Slow arrow indicators
showFastSlowIndicator=true

; Vertical Y position of the Fast/Slow arrow indicators
fastSlowY=666

; Only show Fast/Slow arrow when absolute timing error is greater than this many ms. 0 = show for all non-zero errors.
fastSlowThresholdMs=0
